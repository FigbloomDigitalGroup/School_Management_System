<?xml version="1.0" encoding="utf-8"?>
<!-- FIG-782: branded cold-start splash. Swapped back to @style/AppTheme in
     MainActivity.onCreate before setContentView, so this only shows during
     the gap between process start and the JS bundle taking over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item android:gravity="center" android:width="160dp" android:height="160dp">
        <bitmap android:src="@drawable/splash_logo_teacher" android:gravity="center" />
    </item>
</layer-list>
