<resources>

    <!-- Base application theme. Theme.AppCompat.Light, not ...DayNight: the
         app's own screens are always light (static colour tokens, no dark
         mode support), but DayNight flips native defaults — including
         EditText's default text colour — to the dark/white variant whenever
         the phone's system dark mode is on, which made every TextInput
         render white text on the app's light card background. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!-- FIG-782: cold-start theme, set on MainActivity in the manifest and
         swapped back to AppTheme in onCreate — see splash_background.xml. -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

</resources>
