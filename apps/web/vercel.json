{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/signin", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/org-picker", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/platform/:path*", "destination": "/index.html" },
    { "source": "/s/:path+", "destination": "/index.html" },
    { "source": "/org/:path+", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(signin|signup|org-picker|reset-password)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/platform/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/s/:path+",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/org/:path+",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/portals/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
