{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@figbloom/shared": [
        "../../packages/shared/src/index.ts"
      ]
      
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  // The build (Vercel installs only what the web app needs, not the root's vitest) must not look at test files: they are
  // type-checked by tsconfig.test.json, which `npm run typecheck` also runs.
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}