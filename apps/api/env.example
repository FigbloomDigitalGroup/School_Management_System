# Copy to apps/api/.env (gitignored). Never commit real secrets.
# Isolated local DB only — never point at hosted production-like data (F-008).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:58322/figbloom_api
API_HOST=127.0.0.1
API_PORT=4100
# Session lifetime in seconds (default 12h)
SESSION_TTL_SECONDS=43200
# Login rate limit: 5 tokens, refill +2 every 5 seconds (PG-atomic token bucket)
AUTH_RATE_CAPACITY=5
AUTH_RATE_REFILL=2
AUTH_RATE_INTERVAL_MS=5000

# Proxy trust (R2-01). Default: disabled — socket address only; X-Forwarded-For ignored.
# To enable behind YOUR reverse proxies, set BOTH:
#   API_TRUST_PROXY_HOPS=1
#   API_TRUST_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32
# API_TRUST_PROXY=true is rejected (unsafe boolean trust removed).
API_TRUST_PROXY_HOPS=0
# API_TRUST_PROXY_CIDRS=
