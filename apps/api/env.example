# Copy to apps/api/.env (gitignored). Never commit real secrets.
# Isolated local DB only — never point at hosted production-like data (F-008).

# local | test | staging | production. Unset = local (refused if NODE_ENV=production).
# staging/production: .env is never read; DATABASE_URL to a non-loopback host needs sslmode=verify-full;
# IDEMPOTENCY_FINGERPRINT_KEY (32+ chars, from your secret store) is required; MIGRATION_DATABASE_URL must NOT be set.
APP_ENV=local
# IDEMPOTENCY_FINGERPRINT_KEY=
# SESSION_MINT_HMAC_KEY=  # required outside local/test (32-256 chars, random); must match the database secret. Provision with scripts/session-hmac.mjs (docs/SESSION-HMAC-PROVISIONING.md). Never the local/test default.
IDEMPOTENCY_TTL_SECONDS=86400

# Runtime role (figbloom_app LOGIN). The API reads DATABASE_URL only.
DATABASE_URL=postgresql://figbloom_app:replace-me@127.0.0.1:58322/figbloom_api
# Migrator/owner. Direct or session-mode only. Never the runtime role.
# Never a transaction-mode pooler (pgbouncer=true is refused).
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:58322/figbloom_api
RUNTIME_ROLE=figbloom_app
# Per-process safety cap is 20. Not a production size — see docs/RUNTIME-DATABASE-SECURITY.md.
POOL_MAX=10
POOL_ACQUIRE_TIMEOUT_MS=2000
STATEMENT_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=5000
IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=15000
# Autocommit identity path (login, session lookup, rate limiting, readiness); baseline of every pooled connection.
IDENTITY_STATEMENT_TIMEOUT_MS=5000
IDENTITY_LOCK_TIMEOUT_MS=2000
# Client-side per-query backstop for a stalled network. Must exceed every statement timeout above.
CLIENT_QUERY_TIMEOUT_MS=20000
APPLICATION_NAME=figbloom-api
# /readyz database probe (cache window and time budget) and shutdown sequence.
READINESS_CACHE_MS=1000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_GRACE_MS=10000
SHUTDOWN_HARD_TIMEOUT_MS=15000
MIGRATION_LOCK_TIMEOUT_MS=15000
API_HOST=127.0.0.1
API_PORT=4100
# Session lifetime in seconds (default 12h)
SESSION_TTL_SECONDS=28800
# last_seen_at is written at most once per this many seconds per session (0 = every request).
# Expiry and revocation are still checked on every request.
SESSION_LAST_SEEN_INTERVAL_SECONDS=60
# Sensitive actions (administrator resets, deactivation, finance resolutions) need a login or password re-confirmation within this many seconds
SENSITIVE_REAUTH_WINDOW_SECONDS=300
# Login rate limit: 5 tokens, refill +2 every 5 seconds (PG-atomic token bucket)
AUTH_RATE_CAPACITY=5
AUTH_RATE_REFILL=2
AUTH_RATE_INTERVAL_MS=5000
# Two-step (TOTP) code attempts and enrolments, per account: 5 at once, then one more a minute. Every attempt counts, right or wrong.
# Staging and production refuse a looser setting than this; only local and test may raise it (browser tests that sign in as one admin many times).
MFA_ATTEMPT_RATE_CAPACITY=5
MFA_ATTEMPT_RATE_REFILL=1
MFA_ATTEMPT_RATE_INTERVAL_MS=60000
# M-Pesa callback throttling (separate from the login limit; names and defaults only, no secrets).
# Authenticated callbacks (URL secret matched): one platform-wide bucket sized for provider bursts.
MPESA_CALLBACK_RATE_CAPACITY=200
MPESA_CALLBACK_RATE_REFILL=100
MPESA_CALLBACK_RATE_INTERVAL_MS=1000
# Callbacks with a wrong or missing secret: per client address, drained only by junk traffic.
MPESA_CALLBACK_INVALID_RATE_CAPACITY=10
MPESA_CALLBACK_INVALID_RATE_REFILL=2
MPESA_CALLBACK_INVALID_RATE_INTERVAL_MS=5000

# Browser origins allowed to call the API: comma-separated EXACT origins (scheme://host[:port]).
# Empty = no CORS headers. Wildcards, paths and trailing slashes are refused. Credentials are never allowed.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_MAX_AGE_SECONDS=600
# Send Strict-Transport-Security only where TLS terminates for this host.
HSTS_ENABLED=false
# keep-alive must be longer than the load balancer's idle timeout; headers timeout must exceed keep-alive.
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=30000

# Proxy trust (R2-01). Default: disabled — socket address only; X-Forwarded-For ignored.
# To enable behind YOUR reverse proxies, set BOTH:
#   API_TRUST_PROXY_HOPS=1
#   API_TRUST_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32
# API_TRUST_PROXY=true is rejected (unsafe boolean trust removed).
API_TRUST_PROXY_HOPS=0
# API_TRUST_PROXY_CIDRS=

# Worker process (Stage 11). Separate credential from the API. Never reuse DATABASE_URL.
# WORKER_DATABASE_URL=postgresql://figbloom_worker:replace-me@127.0.0.1:58322/figbloom_api
# WORKER_NAME=worker-local-1
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_LEASE_SECONDS=300   # startup REJECTS a lease below 1.25 x the worst-case handler time (see worker/leasePolicy.ts)
# WORKER_POOL_MAX=2
# WORKER_POOL_ACQUIRE_TIMEOUT_MS=2000
# Session baseline for autocommit (jobs_claim). Tenant transactions apply their own SET LOCAL limits.
# WORKER_STATEMENT_TIMEOUT_MS=15000
# WORKER_LOCK_TIMEOUT_MS=5000
# WORKER_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=15000
# Client-side backstop; must exceed WORKER_STATEMENT_TIMEOUT_MS.
# WORKER_CLIENT_QUERY_TIMEOUT_MS=20000
# WORKER_SHUTDOWN_HARD_TIMEOUT_MS=15000

# FigBloom AI (central AI platform) connection for Bloom AI. All optional: unset = honest 503 not_configured.
# BLOOM_AI_BASE_URL=https://ai.figbloom.example
# BLOOM_AI_API_KEY=
# BLOOM_AI_SIGNING_SECRET=            # >= 32 chars; HMAC-SHA256 request signing shared with FigBloom AI
# BLOOM_AI_TIMEOUT_MS=10000

# MFA (migration 088). enforce is mandatory outside local/test.
# MFA_ENFORCEMENT=enforce
# MFA_REQUIRED_ROLES=teacher,staff      # optional extra rollout roles; admins and finance holders are always required
# MFA_ENCRYPTION_KEY=                   # >= 32 chars, different from SESSION_MINT_HMAC_KEY; required in staging/production

# S3-compatible object storage (migration 090). All optional: unset = honest 503 not_configured.
# S3_BUCKET=figbloom-private-documents
# S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_ENDPOINT=                          # optional for MinIO / R2 / local S3-compatible endpoint
# S3_FORCE_PATH_STYLE=false
# S3_PRESIGN_TTL_SECONDS=300            # 60..900 seconds

# Firebase Cloud Messaging HTTP v1 (migration 089). Optional: unset = honest not_configured.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=                      # PEM private key with \n escapes
# FCM_ACCESS_TOKEN=                     # optional static token for local mock testing only

# Payment gateway selection: daraja (default) or payhero (PayHero Kenya API v2).
# PAYMENT_PROVIDER=payhero
# PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
# PAYHERO_BASIC_AUTH_TOKEN=             # Basic auth token (or set PAYHERO_API_USERNAME + PAYHERO_API_PASSWORD)
# PAYHERO_API_USERNAME=
# PAYHERO_API_PASSWORD=
# PAYHERO_CHANNEL_ID=                   # PayHero collection channel ID (positive integer)
# PAYHERO_CALLBACK_URL=https://api.figbloom.example/v1/payhero/callback
# PAYHERO_CALLBACK_SECRET=              # >= 32 chars; shared secret appended as ?token=
# PAYHERO_HTTP_TIMEOUT_MS=10000

# Invoice delivery providers (optional: unset = honest not_configured; in-app/push still queue via outbox).
# RESEND_API_KEY=
# EMAIL_FROM=billing@figbloom.co.ke
# SMS_API_KEY=                          # Africa's Talking API key
# SMS_USERNAME=                         # Africa's Talking username
# SMS_SENDER_ID=
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_API_TOKEN=

# Teacher handwritten report OCR (optional: set either GEMINI_API_KEY or OPENAI_API_KEY).
# GEMINI_API_KEY=
# GEMINI_OCR_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_OCR_MODEL=gpt-4o-mini
