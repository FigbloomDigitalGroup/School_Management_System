# Copy to apps/api/.env (gitignored). Never commit real secrets.
# Isolated local DB only — never point at hosted production-like data (F-008).

# Runtime role (figbloom_app LOGIN). The API reads DATABASE_URL only.
DATABASE_URL=postgresql://figbloom_app:replace-me@127.0.0.1:58322/figbloom_api
# Migrator/owner. Direct or session-mode only. Never the runtime role.
# Never a transaction-mode pooler (pgbouncer=true is refused).
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:58322/figbloom_api
RUNTIME_ROLE=figbloom_app
# Per-process safety cap is 20. Not a production size — see docs/RUNTIME-DATABASE-SECURITY.md.
POOL_MAX=10
POOL_ACQUIRE_TIMEOUT_MS=2000
STATEMENT_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=5000
IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=15000
APPLICATION_NAME=figbloom-api
# /readyz database probe (cache window and time budget) and shutdown sequence.
READINESS_CACHE_MS=1000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_GRACE_MS=10000
SHUTDOWN_HARD_TIMEOUT_MS=15000
MIGRATION_LOCK_TIMEOUT_MS=15000
API_HOST=127.0.0.1
API_PORT=4100
# Session lifetime in seconds (default 12h)
SESSION_TTL_SECONDS=43200
# Login rate limit: 5 tokens, refill +2 every 5 seconds (PG-atomic token bucket)
AUTH_RATE_CAPACITY=5
AUTH_RATE_REFILL=2
AUTH_RATE_INTERVAL_MS=5000

# Proxy trust (R2-01). Default: disabled — socket address only; X-Forwarded-For ignored.
# To enable behind YOUR reverse proxies, set BOTH:
#   API_TRUST_PROXY_HOPS=1
#   API_TRUST_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32
# API_TRUST_PROXY=true is rejected (unsafe boolean trust removed).
API_TRUST_PROXY_HOPS=0
# API_TRUST_PROXY_CIDRS=
