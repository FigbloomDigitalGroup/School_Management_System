{
  "name": "@figbloom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FigBloom replacement modular monolith — identity, tenancy and RBAC (P1-A / FIG-1573)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:check": "tsx src/openapi/validate.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "yaml": "^2.7.0"
  }
}
