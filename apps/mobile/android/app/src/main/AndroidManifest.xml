<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Driver GPS tracking (FIG-162): a foreground service with a persistent
         notification while a trip is active, so location updates keep landing
         with the phone locked — see src/screens/driver/locationTask.ts. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Calls and live classes (FIG-1291): LiveKit's own manifest adds the microphone,
         camera and Bluetooth permissions it needs (merged in at build). Android 12+
         also wants this one before a Bluetooth headset can carry a call. The hardware
         is optional, so the app is still for phones without a camera. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <!-- Bus tracking map (FIG-874) — react-native-maps on Android needs this
           read from local.properties' MAPS_API_KEY via the build.gradle
           manifestPlaceholder; see that file for why it's not hardcoded here. -->
      <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value="${MAPS_API_KEY}" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/SplashTheme"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- react-native-background-actions declares this service as foregroundServiceType
           "dataSync" by default; overridden to "location" to match what it actually does
           and what ACCESS_BACKGROUND_LOCATION + FOREGROUND_SERVICE_LOCATION grant. -->
      <service
        android:name="com.asterinet.react.bgactions.RNBackgroundActionsTask"
        android:foregroundServiceType="location"
        tools:node="merge" />
    </application>
</manifest>
