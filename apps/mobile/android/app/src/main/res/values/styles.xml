<resources>

    <!-- Base application theme. DayNight, so what the app does not draw itself (the
         dialogs from Alert, the keyboard, text-selection handles, the window behind
         a screen while it slides or the keyboard resizes it) follows the same light
         or dark as the screens. The screens colour themselves from the app's own
         tokens (src/theme.ts), and every text and input sets its colour explicitly,
         so DayNight's native defaults only matter where the app draws nothing.
         Light or dark comes from the phone, or from the person's own pick in Account:
         the app tells Android through Appearance.setColorScheme, which is
         AppCompatDelegate night mode. (Before dark mode this was Theme.AppCompat.Light,
         because DayNight turned every unstyled TextInput white on the always-light screens.) -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- The app's page colour, so there is no white or grey seam under a transition or the keyboard. -->
        <item name="android:windowBackground">@color/app_page</item>
    </style>

    <!-- FIG-782: cold-start theme, set on MainActivity in the manifest and
         swapped back to AppTheme in onCreate — see splash_background.xml. -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

</resources>
