# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-side-only

# M-Pesa Daraja (Safaricom)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-project.supabase.co/functions/v1/mpesa-callback

# App
VITE_APP_NAME=Figbloom
VITE_TENANT_MODE=path

# Google Maps JavaScript API key, for the fleet live map (admin Fleet screen
# and the parent "where's my child's bus" screen). Optional — without it,
# those screens show a "not configured" message instead of a map. Restrict
# the key to the Maps JavaScript API and to your domain(s) in Google Cloud
# Console before using it anywhere but local dev.
VITE_GOOGLE_MAPS_API_KEY=
