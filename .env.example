# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-side-only

# M-Pesa Daraja (Safaricom)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-project.supabase.co/functions/v1/mpesa-callback
# Long random string (e.g. `openssl rand -hex 32`). mpesa-stk-push adds it to the
# callback URL as ?token=; mpesa-callback refuses any callback without it.
DARAJA_CALLBACK_SECRET=

# App
VITE_APP_NAME=Figbloom
VITE_TENANT_MODE=path

# Google Maps key for the web live map (admin Fleet, teacher Buses, the parent's
# "where's my child's bus" and the driver's trip screen). Optional — without it,
# those screens show a "not configured" message instead of a map. This key ships
# in the web bundle, so anyone can copy it: in Google Cloud Console restrict it to
# your domain(s) (HTTP referrers) and to the Maps JavaScript API and Directions
# only, before using it anywhere but local dev. Don't reuse it as the server key
# or the Android key below; see MAPS.md.
VITE_GOOGLE_MAPS_API_KEY=

# Not read from this file: the live arrival times in bus updates come from the
# `bus-tick` edge function, which reads a separate Supabase secret, a key
# restricted to the Routes API only:
#   supabase secrets set GOOGLE_MAPS_SERVER_KEY=...
# Without it updates still go out, with estimated times marked "about".
