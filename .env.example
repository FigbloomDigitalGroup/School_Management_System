# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-side-only

# M-Pesa Daraja (Safaricom)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-project.supabase.co/functions/v1/mpesa-callback
# Long random string (e.g. `openssl rand -hex 32`). mpesa-stk-push adds it to the
# callback URL as ?token=; mpesa-callback refuses any callback without it.
DARAJA_CALLBACK_SECRET=

# App
VITE_APP_NAME=Figbloom
VITE_TENANT_MODE=path

# Google Maps key for the web live map (admin Fleet, teacher Buses, the parent's
# "where's my child's bus" and the driver's trip screen). Optional — without it,
# those screens show a "not configured" message instead of a map. This key ships
# in the web bundle, so anyone can copy it: in Google Cloud Console restrict it to
# your domain(s) (HTTP referrers) and to the Maps JavaScript API and Directions
# only, before using it anywhere but local dev. Don't reuse it as the server key
# or the Android key below; see MAPS.md.
VITE_GOOGLE_MAPS_API_KEY=

# Largest file, in MB, a teacher can attach or upload as a learning material.
# Match it to the project's upload limit (Supabase Dashboard -> Storage ->
# Settings; 50 MB on the free plan). The learning-media bucket itself allows
# up to 2 GB, so raise both together. Unset means 50.
VITE_MAX_UPLOAD_MB=50

# Google Drive, Docs and Sheets in Bloom chat (save answers, chats and tables to
# Drive; attach a file from Drive to a question). Optional: unless all three are
# set, every Drive action is hidden and none of Google's scripts load. The OAuth
# consent screen asks for one scope only, drive.file (files the person picks or
# creates from Bloom). Setup steps are in the PR that added this (Bloom export +
# Google Drive). None of these is a secret, but restrict the API key to the
# Google Picker API and your site's addresses.
#   OAuth client ID, type "Web application", with the site's origins authorised
VITE_GOOGLE_OAUTH_CLIENT_ID=
#   Browser API key restricted to the Google Picker API
VITE_GOOGLE_PICKER_API_KEY=
#   The Google Cloud project number (the Picker's app ID)
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=

# Not read from this file: the live arrival times in bus updates come from the
# `bus-tick` edge function, which reads a separate Supabase secret, a key
# restricted to the Routes API only:
#   supabase secrets set GOOGLE_MAPS_SERVER_KEY=...
# Without it updates still go out, with estimated times marked "about".

# Not read from this file either: in-app calls and live classes run on LiveKit
# Cloud, through the `call-token` edge function, which reads three Supabase
# secrets from the LiveKit project's Settings -> Keys:
#   supabase secrets set LIVEKIT_URL=wss://<project>.livekit.cloud LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...
# Without them the Call and Go live buttons say calls aren't set up yet.
