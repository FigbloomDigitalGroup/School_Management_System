{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@figbloom/shared": [
        "packages/shared/src/index.ts"
      ],
      "@figbloom/shared/*": [
        "packages/shared/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}