{
  "name": "figbloom-school-systems",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Figbloom School Systems — multi-tenant school management for Kenyan secondary schools",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @figbloom/web",
    "dev:mobile": "npm run start --workspace @figbloom/mobile",
    "build": "npm run build --workspace @figbloom/web",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit --pretty && npm run typecheck --workspace @figbloom/web && npm run typecheck --workspace @figbloom/mobile",
    "lint": "eslint .",
    "api:types": "openapi-typescript apps/api/openapi/openapi.yaml -o packages/shared/src/api/schema.d.ts",
    "api:types:check": "npm run api:types && git diff --exit-code -- packages/shared/src/api/schema.d.ts",
    "api:seed": "tsx scripts/api-seed/seed.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:edge": "deno test --allow-env --config supabase/functions/deno.json supabase/functions",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:reset": "supabase db reset",
    "db:seed": "tsx --env-file=.env supabase/seed.ts",
    "db:seed-cbe": "tsx --env-file=.env supabase/seed-cbe.ts",
    "db:seed-org": "tsx --env-file=.env supabase/seed-cbe.ts --with-org",
    "db:fresh": "npm run db:reset && npm run db:seed && npm run db:seed-org",
    "db:simulate-trip": "tsx --env-file=.env supabase/simulate-trip.ts",
    "db:simulate-kijani": "tsx supabase/simulate-kijani.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
